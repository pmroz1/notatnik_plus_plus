# Copy to .env and adjust. Never commit .env.
# There are no credentials here: create the account with `notes-api create-user` (see README).

# Where the SQLite database (notes.db) and backups/ live. Local development only;
# Docker always uses /data inside the container (named volume "notes-data").
NOTES_DATA_DIR=./data

# Address the API listens on. Keep 127.0.0.1 unless you know you need remote access.
NOTES_BIND=127.0.0.1:8080

# Serve the built Angular app from the same origin (production / single-process mode).
# NOTES_STATIC_DIR=apps/web/dist/web/browser

# Set to true when the app is served over HTTPS (adds the Secure attribute to the cookie).
NOTES_COOKIE_SECURE=false

# Login session lifetime in hours (default 14 days).
NOTES_SESSION_TTL_HOURS=336

# Extra origins allowed to send state-changing requests, comma separated.
# Only needed when a proxy rewrites the Host header, e.g. https://notes.example.lan
NOTES_ALLOWED_ORIGINS=

# Log level: error, warn, info, debug
RUST_LOG=info

# Docker Compose only: host address/port to publish the container on.
NOTES_PUBLISH=127.0.0.1:8080
